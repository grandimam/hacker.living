# Optional for Compose; npm run db:setup generates random credentials for local development.
APP_PORT=4317
DATABASE_PORT=55432
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql://hacker_living:replace-with-a-local-password@127.0.0.1:55432/hacker_living

# Independent concurrent stage workers (1–128 each). No API key required.
PIPELINE_LABEL_WORKERS=8
PIPELINE_RESEARCH_WORKERS=6

# Optional Pi RPC pool: uses the existing EasyCLIProxy provider login.
PI_BIN=/opt/homebrew/bin/pi
PI_CLAUDE_MODEL=claude-sonnet-4-6

# Enabled by scripts/setup-aws.sh for public HTTPS (leave disabled for local use).
# COMPOSE_PROFILES=public
# SITE_ADDRESS=hacker.living
