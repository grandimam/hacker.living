{
  "name": "hacker-living",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4317",
    "start": "node --import tsx scripts/serve.ts",
    "build": "node --import tsx scripts/build.ts",
    "check": "tsc --noEmit && node --import tsx scripts/check.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "pipeline:discover": "node --import tsx scripts/pipeline.ts discover",
    "pipeline:review": "node --import tsx scripts/pipeline.ts review",
    "pipeline:draft": "node --import tsx scripts/pipeline.ts draft",
    "pipeline:approve": "node --import tsx scripts/pipeline.ts approve",
    "pipeline:verify": "node --import tsx scripts/pipeline.ts verify",
    "pipeline:label-pilot": "node --import tsx scripts/labeling-pilot.ts",
    "pipeline:download-archive": "node --import tsx scripts/archive-download.ts",
    "pipeline:benchmark-archive": "node --import tsx scripts/archive-benchmark.ts",
    "db:setup": "node --import tsx scripts/db-setup.ts",
    "db:up": "docker compose up -d --wait db",
    "db:stop": "docker compose stop db",
    "db:migrate": "node --import tsx scripts/db-migrate.ts",
    "db:export": "node --import tsx scripts/db-export.ts",
    "pipeline:ingest-month": "node --import tsx scripts/ingest-month.ts",
    "pipeline:work": "node --import tsx scripts/label-worker.ts",
    "test:database": "DATABASE_TESTS=1 node --import tsx --test tests/database.test.ts",
    "db:status": "node --import tsx scripts/db-status.ts",
    "db:backup": "node --import tsx scripts/db-backup.ts",
    "pipeline:run": "node --import tsx scripts/date-pipeline.ts",
    "pipeline:tune": "node --import tsx scripts/tune-pipeline.ts",
    "pipeline:fonts": "node --import tsx scripts/fonts-pipeline.ts",
    "pipeline:pi": "node --import tsx scripts/pi-worker-pool.ts",
    "catalog:export": "node --import tsx scripts/catalog-transfer.ts export",
    "catalog:import": "node --import tsx scripts/catalog-transfer.ts import"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "dotenv": "^18.0.9",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@duckdb/node-api": "^2.0.0-r.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/leaflet": "^1.9.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "ws": "^8.22.1"
  }
}
