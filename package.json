{
  "name": "hacker-living",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx scripts/prepare-data.ts && vite --host 127.0.0.1 --port 4317",
    "start": "vite preview --host 127.0.0.1 --port 4317",
    "build": "node --import tsx scripts/build.ts",
    "check": "tsc --noEmit && node --import tsx scripts/check.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "pipeline:discover": "node --import tsx scripts/pipeline.ts discover",
    "pipeline:review": "node --import tsx scripts/pipeline.ts review",
    "pipeline:draft": "node --import tsx scripts/pipeline.ts draft",
    "pipeline:approve": "node --import tsx scripts/pipeline.ts approve",
    "pipeline:verify": "node --import tsx scripts/pipeline.ts verify",
    "pipeline:label-pilot": "node --import tsx scripts/labeling-pilot.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/leaflet": "^1.9.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "ws": "^8.22.1"
  }
}
