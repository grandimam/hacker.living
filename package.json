{
  "name": "hacker-living",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-data.mjs && vite --host 127.0.0.1 --port 4317",
    "start": "vite preview --host 127.0.0.1 --port 4317",
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit && node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "pipeline:discover": "node scripts/pipeline.mjs discover",
    "pipeline:review": "node scripts/pipeline.mjs review",
    "pipeline:draft": "node scripts/pipeline.mjs draft",
    "pipeline:approve": "node scripts/pipeline.mjs approve",
    "pipeline:verify": "node scripts/pipeline.mjs verify"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "vite": "^7.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.7.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/leaflet": "^1.9.0",
    "@types/node": "^22.0.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0"
  }
}
