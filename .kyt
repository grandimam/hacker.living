# Copy to hacker-living/.kyt. Add server.identity for your EC2 private-key path,
# or load the matching key into your SSH agent.
name = "hacker-living"
domain = "hacker.living"
exclude = ["data"]

[server]
host = "ec2-user@34.204.96.144"
port = 22

[app]
port = 4317
healthcheck = "/api/health"

[compose]
file = "compose.yaml"
project = "hacker-living"
profiles = ["public"]
generate_env = ["POSTGRES_PASSWORD"]
arch = "x86_64"

[compose.environment]
SITE_ADDRESS = "hacker.living"

# Workspace inspection (does not change deployment or expose database ports).

[[apis]]
name = "Health"
path = "/api/health"

[[apis]]
name = "Processing metrics"
path = "/api/metrics"

[[apis]]
name = "Discoveries"
path = "/api/discoveries?limit=20"

[[apis]]
name = "Recommendations"
path = "/api/recommendations?limit=20"

[[apis]]
name = "Places"
path = "/api/places?limit=20"

[[apis]]
name = "Fonts"
path = "/api/fonts?limit=20"

[database]
service = "db"
name = "hacker_living"
user = "hacker_living"
